/* Help article bodies */
"help.article.gs_1.title" = "Membuat akun Wedding App";
"help.article.gs_1.summary" = "Daftar akun baru dan mulai merencanakan pernikahan Anda.";
"help.article.gs_1.body" = "Untuk membuat akun, buka aplikasi Wedding App lalu pilih Daftar. Isi nama lengkap, email, dan kata sandi Anda.\n\nAnda juga dapat mendaftar lebih cepat menggunakan akun Google atau Apple. Setelah berhasil, Anda akan langsung masuk ke beranda aplikasi dan dapat mulai mengisi detail pernikahan.";
"help.article.gs_2.title" = "Login dengan email atau Google";
"help.article.gs_2.summary" = "Cara masuk ke akun yang sudah terdaftar.";
"help.article.gs_2.body" = "Buka halaman Masuk, lalu masukkan email dan kata sandi Anda. Jika Anda mendaftar lewat Google, pilih tombol Lanjutkan dengan Google.\n\nPastikan koneksi internet aktif. Jika lupa kata sandi, gunakan fitur Lupa kata sandi di halaman login untuk memulihkan akses akun.";
"help.article.gs_3.title" = "Mengisi profil pasangan";
"help.article.gs_3.summary" = "Lengkapi nama mempelai dan informasi dasar pasangan.";
"help.article.gs_3.body" = "Buka menu Lainnya, pilih Pasangan, lalu isi nama mempelai wanita dan pria. Anda juga dapat menambahkan budaya atau konsep pernikahan.\n\nInformasi ini akan tampil di beranda dan halaman Detail Pernikahan sehingga seluruh rencana terasa lebih personal.";
"help.article.gs_4.title" = "Navigasi menu utama aplikasi";
"help.article.gs_4.summary" = "Kenali tab Beranda, Checklist, Tamu, Budget, dan Lainnya.";
"help.article.gs_4.body" = "Beranda menampilkan ringkasan progres pernikahan. Checklist berisi tugas persiapan. Tamu untuk mengelola daftar undangan. Budget untuk mencatat pengeluaran dan uang masuk.\n\nMenu Lainnya berisi pengaturan akun, dokumen, inspirasi, privasi, dan bantuan. Gunakan tab bawah untuk berpindah antar fitur utama dengan cepat.";
"help.article.gs_5.title" = "Mengatur detail pernikahan";
"help.article.gs_5.summary" = "Atur tanggal, lokasi, dan rangkaian acara pernikahan.";
"help.article.gs_5.body" = "Dari menu Lainnya, buka Detail Pernikahan. Di sana Anda dapat melihat ringkasan acara, jadwal, dan daftar tamu.\n\nKetuk Edit untuk memperbarui tanggal, lokasi, konsep pernikahan, serta catatan penting yang ingin dibagikan ke vendor atau keluarga.";
"help.article.gs_6.title" = "Tips memulai perencanaan dengan baik";
"help.article.gs_6.summary" = "Langkah awal yang disarankan untuk pasangan baru.";
"help.article.gs_6.body" = "Mulailah dengan mengisi detail pernikahan dan checklist prioritas 3 bulan pertama. Tentukan budget kasar, lalu catat vendor utama yang sudah dihubungi.\n\nManfaatkan fitur inspirasi untuk mengumpulkan referensi dekorasi, gaun, dan venue. Rencanakan sedikit demi sedikit agar persiapan tetap terkendali.";
"help.article.prep_1.title" = "Memahami checklist persiapan";
"help.article.prep_1.summary" = "Cara membaca dan menggunakan checklist di aplikasi.";
"help.article.prep_1.body" = "Checklist membantu Anda melacak tugas persiapan dari awal hingga hari H. Setiap tugas memiliki status: Belum Mulai, Berjalan, atau Selesai.\n\nGunakan filter dan pencarian untuk menemukan tugas tertentu. Progress keseluruhan ditampilkan di bagian atas agar Anda tahu seberapa jauh persiapan sudah berjalan.";
"help.article.prep_2.title" = "Menyelesaikan tugas dan sub-tugas";
"help.article.prep_2.summary" = "Tandai progres dan kelola detail setiap tugas.";
"help.article.prep_2.body" = "Ketuk tugas untuk melihat detail lengkap. Di dalamnya Anda dapat membaca deskripsi, mengubah status, dan mengerjakan sub-tugas satu per satu.\n\nTandai sub-tugas sebagai selesai agar progress tugas induk ikut terupdate. Ini memudahkan Anda membagi pekerjaan besar menjadi langkah-langkah kecil.";
"help.article.prep_3.title" = "Melampirkan dokumen di checklist";
"help.article.prep_3.summary" = "Simpan kontrak, invoice, dan file penting per tugas.";
"help.article.prep_3.body" = "Setiap tugas dapat memiliki lampiran seperti PDF, JPG, atau PNG. File yang dilampirkan juga dapat muncul di menu Dokumen untuk akses cepat.\n\nGunakan lampiran untuk menyimpan kontrak vendor, bukti pembayaran, atau referensi desain agar semua informasi berada di satu tempat.";
"help.article.prep_4.title" = "Mengatur timeline persiapan";
"help.article.prep_4.summary" = "Prioritaskan tugas berdasarkan waktu menuju pernikahan.";
"help.article.prep_4.body" = "Lihat tugas yang memiliki target selesai terdekat di beranda pada bagian Selanjutnya. Urutkan checklist berdasarkan prioritas atau deadline.\n\nFokuskan energi pada tugas kritis seperti booking venue, catering, dan dokumentasi terlebih dahulu sebelum menangani detail dekoratif.";
"help.article.prep_5.title" = "Tips persiapan 3 bulan sebelum pernikahan";
"help.article.prep_5.summary" = "Checklist penting yang sebaiknya sudah selesai.";
"help.article.prep_5.body" = "Tiga bulan sebelum acara, pastikan vendor utama sudah dikonfirmasi, jadwal fitting selesai, dan daftar tamu mulai dirapikan.\n\nTinjau budget secara berkala, finalisasi rundown acara, dan pastikan semua pembayaran termin vendor tercatat di aplikasi.";
"help.article.prep_6.title" = "Tips persiapan 1 bulan sebelum pernikahan";
"help.article.prep_6.summary" = "Hal-hal yang perlu dicek menjelang hari H.";
"help.article.prep_6.body" = "Satu bulan sebelum pernikahan, konfirmasi ulang semua vendor, cek jumlah tamu yang hadir, dan pastikan dokumen penting sudah lengkap.\n\nSiapkan catatan khusus untuk hari H, termasuk kontak vendor, alur acara, dan daftar barang yang harus dibawa ke venue.";
"help.article.prep_7.title" = "Menyimpan vendor pilihan";
"help.article.prep_7.summary" = "Kelola daftar vendor yang sedang Anda pertimbangkan.";
"help.article.prep_7.body" = "Saat menjelajahi tab Vendor, simpan vendor favorit Anda agar mudah dibandingkan nanti. Vendor tersimpan dapat diakses dari menu Lainnya.\n\nCatat juga komunikasi dengan vendor melalui fitur Pesan agar semua kesepakatan terdokumentasi dengan rapi.";
"help.article.prep_8.title" = "Menyimpan inspirasi pernikahan";
"help.article.prep_8.summary" = "Kumpulkan ide dekorasi, gaun, dan konsep acara.";
"help.article.prep_8.body" = "Buka Inspirasi & Ide untuk melihat referensi terbaru. Ketuk Simpan pada ide yang Anda suka agar bisa dibuka kembali kapan saja.\n\nGunakan kategori seperti Dekorasi, Gaun, Makeup, Katering, dan Venue untuk mengorganisir inspirasi sesuai kebutuhan perencanaan.";
"help.article.bud_1.title" = "Mengatur total budget pernikahan";
"help.article.bud_1.summary" = "Tetapkan anggaran keseluruhan rencana pernikahan.";
"help.article.bud_1.body" = "Buka tab Budget untuk melihat ringkasan anggaran. Atur total budget sesuai rencana keuangan Anda agar pengeluaran lebih terkontrol.\n\nSetelah total budget ditetapkan, Anda dapat melihat sisa anggaran, komitmen pembayaran, dan pengeluaran yang sudah terjadi secara real-time.";
"help.article.bud_2.title" = "Menambahkan pengeluaran (expense)";
"help.article.bud_2.summary" = "Catat setiap biaya yang sudah atau akan dikeluarkan.";
"help.article.bud_2.body" = "Ketuk Tambah Expense, lalu isi nama pengeluaran, kategori, nominal, dan tanggal jatuh tempo jika ada.\n\nSetiap expense yang tersimpan akan masuk ke ringkasan per kategori sehingga Anda tahu bagian mana yang paling banyak menyerap anggaran.";
"help.article.bud_3.title" = "Mengelola kategori anggaran";
"help.article.bud_3.summary" = "Alokasikan budget per kategori seperti venue, catering, dan dekorasi.";
"help.article.bud_3.body" = "Gunakan fitur Kategori Budget untuk membagi anggaran ke beberapa kategori utama. Anda dapat menyesuaikan alokasi sesuai prioritas pernikahan.\n\nPantau apakah pengeluaran aktual sudah mendekati batas kategori agar tidak ada kejutan di akhir perencanaan.";
"help.article.bud_4.title" = "Mencatat uang masuk dan hadiah";
"help.article.bud_4.summary" = "Catat amplop, transfer, dan bantuan finansial lainnya.";
"help.article.bud_4.body" = "Selain pengeluaran, Anda juga dapat mencatat uang masuk dari keluarga atau hadiah tunai. Ini membantu melihat keseimbangan keuangan pernikahan secara menyeluruh.\n\nPastikan setiap pencatatan disertai keterangan sumber dan tanggal agar laporan lebih akurat.";
"help.article.bud_5.title" = "Jadwal pembayaran vendor";
"help.article.bud_5.summary" = "Kelola termin dan tanggal bayar ke vendor.";
"help.article.bud_5.body" = "Di bagian jadwal pembayaran, catat kapan pembayaran ke vendor harus dilakukan. Tandai status pembayaran agar tidak ada termin yang terlewat.\n\nKombinasikan jadwal ini dengan checklist persiapan agar pembayaran dan progress vendor selaras.";
"help.article.bud_6.title" = "Membaca ringkasan pengeluaran";
"help.article.bud_6.summary" = "Pahami grafik dan statistik budget Anda.";
"help.article.bud_6.body" = "Ringkasan anggaran menampilkan total budget, terpakai, komitmen, dan sisa anggaran dalam bentuk angka dan persentase.\n\nGunakan informasi ini saat evaluasi mingguan untuk memutuskan apakah perlu menyesuaikan vendor, jumlah tamu, atau konsep acara.";
"help.article.bud_7.title" = "Tips menghemat budget pernikahan";
"help.article.bud_7.summary" = "Strategi praktis menjaga anggaran tetap sehat.";
"help.article.bud_7.body" = "Tetapkan prioritas 3 hal terpenting, lalu alokasikan budget terbesar di sana. Bandingkan minimal 2–3 vendor sebelum memutuskan.\n\nCatat semua pengeluaran kecil karena seringkali yang terlewat justru menambah beban. Review budget setiap minggu agar tetap on track.";
"help.article.gst_1.title" = "Menambahkan tamu ke daftar";
"help.article.gst_1.summary" = "Cara mencatat tamu beserta kontaknya.";
"help.article.gst_1.body" = "Buka tab Tamu, lalu ketuk Tambah Tamu. Isi nama, nomor telepon, email, dan grup tamu jika diperlukan.\n\nSemakin lengkap data tamu, semakin mudah Anda mengirim undangan dan melacak konfirmasi kehadiran.";
"help.article.gst_2.title" = "Mengelola status RSVP tamu";
"help.article.gst_2.summary" = "Pantau tamu yang sudah konfirmasi, pending, atau tidak hadir.";
"help.article.gst_2.body" = "Setiap tamu memiliki status RSVP: Konfirmasi, Pending, atau Tidak Hadir. Ringkasan RSVP ditampilkan di bagian atas halaman Tamu.\n\nPerbarui status secara berkala agar perhitungan kursi, catering, dan souvenir lebih akurat.";
"help.article.gst_3.title" = "Mengundang tamu via WhatsApp";
"help.article.gst_3.summary" = "Bagikan undangan digital langsung ke kontak tamu.";
"help.article.gst_3.body" = "Pastikan nomor WhatsApp tamu sudah diisi. Dari detail tamu, Anda dapat membagikan undangan atau pesan konfirmasi kehadiran.\n\nSertakan informasi tanggal, lokasi, dan link undangan digital agar tamu mudah memahami detail acara.";
"help.article.gst_4.title" = "Mengelompokkan tamu";
"help.article.gst_4.summary" = "Atur tamu berdasarkan keluarga, teman, atau kolega.";
"help.article.gst_4.body" = "Gunakan field grup atau catatan untuk mengelompokkan tamu. Pengelompokan membantu saat menentukan meja, zona duduk, atau prioritas undangan.\n\nAnda juga dapat mencari tamu berdasarkan nama atau grup menggunakan kolom pencarian.";
"help.article.gst_5.title" = "Melacak jumlah tamu hadir";
"help.article.gst_5.summary" = "Gunakan ringkasan tamu untuk estimasi akomodasi.";
"help.article.gst_5.body" = "Lihat total tamu dan jumlah yang sudah konfirmasi di ringkasan RSVP. Data ini juga tersedia di halaman Detail Pernikahan pada tab Tamu.\n\nGunakan angka tersebut untuk koordinasi dengan venue dan katering agar porsi dan tempat duduk sesuai kebutuhan.";
"help.article.sec_1.title" = "Mengubah kata sandi akun";
"help.article.sec_1.summary" = "Perbarui kata sandi untuk menjaga keamanan akun.";
"help.article.sec_1.body" = "Buka Lainnya → Privasi & Keamanan → Ubah Kata Sandi. Masukkan kata sandi saat ini, lalu kata sandi baru minimal 8 karakter.\n\nSetelah kata sandi diubah, sesi login di perangkat lain akan diakhiri otomatis demi keamanan akun Anda.";
"help.article.sec_2.title" = "Kelola sesi aktif perangkat";
"help.article.sec_2.summary" = "Lihat dan akhiri sesi login di perangkat lain.";
"help.article.sec_2.body" = "Di menu Sesi Aktif, Anda dapat melihat daftar perangkat yang sedang login ke akun. Jika ada perangkat yang tidak dikenal, akhiri sesinya segera.\n\nSetelah mengakhiri sesi mencurigakan, sebaiknya ubah kata sandi Anda sebagai langkah pencegahan tambahan.";
"help.article.sec_3.title" = "Privasi data pribadi Anda";
"help.article.sec_3.summary" = "Bagaimana Wedding App melindungi informasi Anda.";
"help.article.sec_3.body" = "Data pernikahan, tamu, dan dokumen Anda hanya dapat diakses oleh akun yang login. Kami menerapkan standar keamanan untuk melindungi informasi pribadi.\n\nBaca Kebijakan Privasi di menu Privasi & Keamanan untuk detail lengkap tentang pengumpulan dan penggunaan data.";
"help.article.sec_4.title" = "Login dengan Google atau Apple";
"help.article.sec_4.summary" = "Keamanan akun yang masuk lewat metode sosial.";
"help.article.sec_4.body" = "Jika Anda login menggunakan Google atau Apple, autentikasi dikelola oleh penyedia tersebut. Ubah kata sandi tidak tersedia langsung di aplikasi untuk metode login ini.\n\nUntuk keamanan, pastikan akun Google atau Apple Anda juga dilindungi dengan verifikasi dua langkah.";
"help.article.sec_5.title" = "Menghapus akun secara permanen";
"help.article.sec_5.summary" = "Cara menghapus akun dan seluruh data terkait.";
"help.article.sec_5.body" = "Buka Privasi & Keamanan → Hapus Akun. Konfirmasi dengan mengetik HAPUS dan masukkan kata sandi jika diperlukan.\n\nPenghapusan bersifat permanen. Semua data pernikahan, tamu, budget, dan dokumen akan hilang dan tidak dapat dipulihkan.";
"help.article.sec_6.title" = "Mengunduh data saya";
"help.article.sec_6.summary" = "Ekspor salinan data pribadi Anda.";
"help.article.sec_6.body" = "Fitur Unduh Data Saya memungkinkan Anda mengekspor salinan informasi akun dan data pernikahan yang tersimpan.\n\nGunakan fitur ini jika Anda ingin menyimpan arsip pribadi atau memindahkan data sebelum menutup akun.";
